        "obligation": "production_edit",
        "evidence": "Repair the Account GET-response field read from `postalCode` to `postcode` while preserving the internal `AddressSnapshot.postalCode` value consumed by quote creation."
      },
      {
        "repo": "shipment-service",
        "obligation": "validation_only",
        "evidence": "Validate the restored Order estimate request continues to bind its existing `postalCode` request field."
