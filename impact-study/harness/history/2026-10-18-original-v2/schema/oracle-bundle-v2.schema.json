{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oracle-bundle-v2",
  "type": "object",
  "required": [
    "protocol_version",
    "snapshot_sha256",
    "artifacts",
    "attestations",
    "change_id",
    "record_sha256"
  ],
  "properties": {
    "protocol_version": {
      "const": 2,
      "type": "integer"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "claim",
          "artifact_paths"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "repositories",
              "obligations",
              "symbols",
              "edges",
              "actions"
            ]
          },
          "claim": {
            "type": "object"
          },
          "artifact_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "snapshot_sha256",
          "artifact_path"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "artifact_path": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "change_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
