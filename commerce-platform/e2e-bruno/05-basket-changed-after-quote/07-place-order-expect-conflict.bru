meta {
  name: place order after basket changed
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Idempotency-Key: {{idempotencyKey}}
}

script:pre-request {
  if (!bru.getVar("idempotencyKey")) {
    bru.setVar("idempotencyKey",
      "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => {
        const r = Math.random() * 16 | 0;
        return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16);
      }));
  }
}

body:json {
  {
    "quoteId": "{{quoteId}}",
    "payment": {
      "method": "CREDIT_CARD",
      "token": "tok_success"
    }
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("orderId", body.orderId);
  console.log("BRUNOORDER=" + body.orderId);
}

tests {
  test("rejected because basket changed", function() {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().code).to.equal("BASKET_VERSION_CHANGED");
  });
}
