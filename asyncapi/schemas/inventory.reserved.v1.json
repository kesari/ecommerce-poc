{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.reserved.v1",
  "type": "object",
  "required": ["orderId", "reservationId", "expiresAt"],
  "properties": {
    "orderId": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "reservationId": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "expiresAt": {"type": "string", "format": "date-time"}
  }
}
