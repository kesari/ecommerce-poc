{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.reserve.requested.v1",
  "type": "object",
  "required": ["orderId", "items"],
  "properties": {
    "orderId": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["productId", "quantity"],
        "properties": {
          "productId": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "quantity": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
