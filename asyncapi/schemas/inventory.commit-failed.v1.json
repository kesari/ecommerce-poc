{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inventory.commit-failed.v1",
  "type": "object",
  "required": ["orderId", "reason"],
  "properties": {
    "orderId": {"type":"string","format":"uuid","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "reason": {"enum": ["RESERVATION_NOT_FOUND", "RESERVATION_NOT_PENDING", "RESERVATION_EXPIRED"]}
  }
}
