<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.poc.account.infrastructure.persistence.mapper.UserMapper">

    <sql id="columns">
        id, email, password_hash AS passwordHash, created_at AS createdAt
    </sql>

    <insert id="insert">
        INSERT INTO users (id, email, password_hash)
        VALUES (#{id}, #{email}, #{passwordHash})
    </insert>

    <select id="existsByEmail" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM users WHERE email = #{email})
    </select>

    <select id="findByEmail" resultType="com.poc.account.infrastructure.persistence.row.UserRow">
        SELECT <include refid="columns"/>
        FROM users
        WHERE email = #{email}
    </select>

    <select id="findById" resultType="com.poc.account.infrastructure.persistence.row.UserRow">
        SELECT <include refid="columns"/>
        FROM users
        WHERE id = #{id}
    </select>
</mapper>
