meta {
  name: signup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/signup
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("email", "e2e" + Date.now() + "@example.com");
}

body:json {
  {
    "email": "{{email}}",
    "password": "correct-horse-battery-42"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("accessToken", body.accessToken);
}

tests {
  test("signup returns 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
