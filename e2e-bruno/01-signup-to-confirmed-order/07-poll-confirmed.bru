meta {
  name: poll until confirmed
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/orders/{{orderId}}
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:post-response {
  await (async () => {
    const deadline = Date.now() + 45000;
    let status = res.getBody().status;
    while (status === "PENDING" && Date.now() < deadline) {
      await new Promise(r => setTimeout(r, 2000));
      const response = await fetch("{{baseUrl}}/api/v1/orders/" + bru.getVar("orderId"), {
        headers: { "Authorization": "Bearer " + bru.getVar("accessToken") }
      });
      if (response.ok) {
        status = (await response.json()).status;
      }
    }
    bru.setVar("finalStatus", status);
  })();
}

tests {
  test("saga reached CONFIRMED", function() {
    expect(bru.getVar("finalStatus")).to.equal("CONFIRMED");
  });
}
