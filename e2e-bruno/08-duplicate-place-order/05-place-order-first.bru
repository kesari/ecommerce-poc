meta {
  name: place order
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/orders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
  Idempotency-Key: {{idempotencyKey}}
}

script:pre-request {
  if (!bru.getVar("idempotencyKey")) {
    bru.setVar("idempotencyKey",
      "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, c => {
        const r = Math.random() * 16 | 0;
        return (c === "x" ? r : (r & 0x3 | 0x8)).toString(16);
      }));
  }
}

body:json {
  {
    "quoteId": "{{quoteId}}",
    "payment": {
      "method": "CREDIT_CARD",
      "token": "tok_success"
    }
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("orderId", body.orderId);
  console.log("BRUNOORDER=" + body.orderId);
}

tests {
  test("order accepted for processing", function() {
    expect(res.getStatus()).to.equal(202);
    expect(["PENDING", "INVENTORY_RESERVATION_PENDING", "INVENTORY_RESERVED", "PAYMENT_PENDING"])
      .to.include(res.getBody().status);
  });
}
