meta {
  name: create checkout quote
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/checkout/quotes
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "addressId": "{{addressId}}"
  }
}

script:post-response {
  bru.setVar("quoteId", res.getBody().quoteId);
}

tests {
  test("quote created with breakdown", function() {
    expect(res.getStatus()).to.equal(200);
    const b = res.getBody();
    expect(b.price.totalMinor).to.be.above(0);
    expect(b.price.taxMinor).to.be.at.least(0);
    expect(b.estimatedDelivery.from).to.be.a("string");
  });
}
